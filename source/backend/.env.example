# YeahPay 后端环境配置模板
# 复制此文件为 .env 后按部署环境修改；不要把真实 .env 提交到 Git。

# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET=change-this-to-a-random-secret

# development / production
ENVIRONMENT=development

# PC 前端允许访问的来源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# DuckDB 正式数据文件（后端只读打开）
DUCKDB_PATH=/opt/yeahpay/data/active/merchant.duckdb

# SQLite 业务状态库：账号、预警、推送、跟进、复盘与发布日期均保存在这里
SQLITE_PATH=/opt/yeahpay/app/data/biz.db

# 正式库只读路径、待发布候选库和可恢复备份目录。生产环境应全部显式配置，
# 且 active/candidate 必须位于同一磁盘，确认发布才能使用原子替换。
DUCKDB_CANDIDATE_PATH=/opt/yeahpay/data/candidate/merchant.duckdb
DUCKDB_BACKUP_DIR=/opt/yeahpay/data/backup
DUCKDB_RELEASE_GATE_ENABLED=true
# 候选库一次减少有效商户的安全阈值；超过 20% 时禁止发布，防止把截断快照当成完整数据。
DATA_REFRESH_MAX_MERCHANT_REMOVAL_RATIO=0.20

# 交易导入脚本（生产环境必须配置为实际可执行的 ETL 脚本）
ETL_SCRIPT_PATH=/opt/yeahpay/etl/cloud_etl.py
