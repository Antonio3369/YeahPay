.sales-hero{display:flex;align-items:center;padding:28rpx}
.sales-avatar{width:84rpx;height:84rpx;border-radius:50%;background:rgba(102,119,223,.14);border:2rpx solid rgba(102,119,223,.35);display:flex;align-items:center;justify-content:center;color:var(--ac);font-size:34rpx;font-weight:700;margin-right:20rpx}
.sales-identity{display:flex;flex-direction:column;gap:8rpx;min-width:0}
.sales-name{font-size:30rpx;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sales-caption{font-size:20rpx;color:var(--t3)}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:24rpx 0}
.summary-card{background:var(--card);border:2rpx solid var(--line);border-radius:var(--rs);padding:22rpx 18rpx;display:flex;flex-direction:column;gap:8rpx}
.summary-card-wide{grid-column:span 2}
.summary-value{font-size:28rpx;color:var(--ac);font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.summary-label{font-size:20rpx;color:var(--t3)}
.summary-compare{font-size:18rpx;line-height:1.4;white-space:nowrap}
.compare-up{color:var(--sc)}
.compare-down{color:var(--dg)}
.compare-flat{color:var(--t3)}
.chart-card{padding:12rpx}
.sales-chart{height:360rpx;width:100%}
.sales-chart ec-canvas{display:block;width:100%;height:100%}
.merchant-list{padding:0 24rpx}
.merchant-row{display:flex;align-items:center;gap:14rpx;padding:22rpx 0;border-bottom:2rpx solid var(--line)}
.merchant-row:last-child{border-bottom:none}
.merchant-rank{width:44rpx;color:var(--ac);font-size:22rpx;font-weight:700}
.merchant-identity{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx}
.merchant-name{font-size:24rpx;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.merchant-id{font-size:18rpx;color:var(--t3)}
.merchant-amount{font-size:22rpx;color:var(--ac);font-variant-numeric:tabular-nums}
