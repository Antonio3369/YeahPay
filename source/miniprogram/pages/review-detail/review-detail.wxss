.review-detail-page{padding-bottom:70rpx}
.detail-hero{padding:30rpx 24rpx;background:var(--card);border-radius:var(--r);border:2rpx solid var(--line)}
.detail-kicker{font-size:18rpx;letter-spacing:3rpx;color:var(--ac);font-weight:700}
.detail-merchant{margin-top:14rpx;color:var(--text);font-size:32rpx;font-weight:700;line-height:1.35}
.detail-sub{margin-top:10rpx;color:var(--t2);font-size:22rpx;line-height:1.5}
.detail-summary{display:flex;gap:12rpx;margin:18rpx 0 34rpx}
.detail-summary>view{flex:1;min-width:0;padding:18rpx 8rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--rs);text-align:center}
.summary-value{display:block;color:var(--ac);font-size:27rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.summary-green{color:var(--sc)}
.summary-label{display:block;margin-top:8rpx;color:var(--t3);font-size:18rpx}
.effect-card{margin-bottom:34rpx;padding:24rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r)}
.effect-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.effect-title{color:var(--text);font-size:28rpx;font-weight:700}
.effect-sub{margin-top:8rpx;color:var(--t3);font-size:18rpx}
.effect-label{flex:none;padding:8rpx 14rpx;border-radius:999rpx;background:rgba(102,119,223,.12);color:var(--ac);font-size:18rpx}
.effect-grid{display:flex;gap:10rpx;margin-top:24rpx}
.effect-cell{flex:1;min-width:0;padding:16rpx 10rpx;background:rgba(255,255,255,.025);border-radius:var(--rs)}
.effect-value{display:block;color:var(--text);font-size:25rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.effect-caption{display:block;margin-top:8rpx;color:var(--t3);font-size:17rpx;line-height:1.35}
.effect-change{display:block;margin-top:8rpx;color:var(--sc);font-size:19rpx;font-weight:600}
.effect-count{display:block;margin-top:6rpx;color:var(--t3);font-size:17rpx}
.effect-chart{height:300rpx;margin-top:18rpx}
.effect-chart ec-canvas{display:block;width:100%;height:100%}
.effect-note{margin-top:10rpx;color:var(--t3);font-size:17rpx;line-height:1.5}
.effect-wait{margin-bottom:34rpx;padding:22rpx 24rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r);color:var(--t2);font-size:21rpx;line-height:1.5}
.timeline-title{margin-bottom:18rpx;color:var(--text);font-size:28rpx;font-weight:700}
.timeline{position:relative;padding-left:34rpx}
.timeline::before{content:'';position:absolute;left:9rpx;top:10rpx;bottom:20rpx;width:2rpx;background:rgba(102,119,223,.25)}
.timeline-item{position:relative;padding-bottom:24rpx}
.timeline-dot{position:absolute;left:-31rpx;top:8rpx;width:18rpx;height:18rpx;border-radius:50%;background:var(--ac);box-shadow:0 0 0 6rpx rgba(102,119,223,.12)}
.timeline-content{padding:20rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--rs)}
.timeline-top{display:flex;justify-content:space-between;gap:12rpx}
.timeline-result{color:var(--text);font-size:23rpx;font-weight:600}
.timeline-time{color:var(--t3);font-size:18rpx}
.timeline-meta{margin-top:10rpx;color:var(--ac);font-size:19rpx}
.timeline-note{margin-top:10rpx;color:var(--t2);font-size:22rpx;line-height:1.55}
.detail-empty{text-align:center;color:var(--t3);padding:90rpx 0}
