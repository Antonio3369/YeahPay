<view class="page-container review-detail-page">
  <view class="detail-hero" wx:if="{{source}}"><view class="detail-kicker">{{sourceType === 'push' ? '人工推送復盤' : '系統預警復盤'}}</view><view class="detail-merchant">{{source.merchant_name}}</view><view class="detail-sub" wx:if="{{sourceType === 'alert'}}">{{source.title}}</view><view class="detail-sub" wx:else>推送備註：{{source.push_note || '—'}}</view></view>
  <view class="detail-summary" wx:if="{{source}}"><view><text class="summary-value">{{touchCount}}</text><text class="summary-label">次跟進</text></view><view><text class="summary-value summary-green">{{source.status === 'resolved' ? '已解決' : '跟進中'}}</text><text class="summary-label">當前狀態</text></view><view><text class="summary-value">{{sourceType === 'push' ? (source.touch_type === 'offline' ? '線下' : '線上') : '—'}}</text><text class="summary-label">最後觸達</text></view></view>
  <view class="effect-card" wx:if="{{effect && effect.data_ready}}"><view class="effect-head"><view><view class="effect-title">解決後的交易變化</view><view class="effect-sub">解決日 {{effectView.resolvedDate}} · 數據至 {{effectView.latestDate}}</view></view><text class="effect-label">{{effectView.effectLabel}}</text></view><view class="effect-grid"><view class="effect-cell"><text class="effect-value">{{effectView.beforeAmount}}</text><text class="effect-caption">前30天成功交易額</text><text class="effect-count">{{effectView.beforeCount}} 筆</text></view><view class="effect-cell"><text class="effect-value">{{effectView.after7Amount}}</text><text class="effect-caption">解決後{{effectView.after7Days}}天</text><text class="effect-change">{{effectView.after7Change}}</text><text class="effect-count">{{effectView.after7Count}} 筆</text></view><view class="effect-cell"><text class="effect-value">{{effectView.after30Amount}}</text><text class="effect-caption">解決後{{effectView.after30Days}}天</text><text class="effect-change">{{effectView.after30Change}}</text><text class="effect-count">{{effectView.after30Count}} 筆</text></view></view><view class="effect-chart"><ec-canvas id="reviewEffectChart" canvas-id="reviewEffectChart" ec="{{ecEffect}}" /></view><view class="effect-note">變化比例按「日均成功交易額」比較，避免7天和30天觀察週期不同造成誤判。</view></view>
  <view class="effect-wait" wx:elif="{{effect && effect.reason}}">{{effect.reason}}</view>
  <view class="timeline-title">復盤軌跡</view>
  <view class="timeline" wx:if="{{records.length}}"><view class="timeline-item" wx:for="{{records}}" wx:key="id"><view class="timeline-dot"></view><view class="timeline-content"><view class="timeline-top"><text class="timeline-result">{{item.result === 'resolved' ? '已解決' : '跟進記錄'}}</text><text class="timeline-time">{{item.created_at}}</text></view><view class="timeline-meta">{{item.user_name || '—'}} · {{item.touch_type === 'offline' ? '線下觸達' : (item.touch_type === 'online' ? '線上觸達' : '其他記錄')}}</view><view class="timeline-note">{{item.note || '未填寫備註'}}</view></view></view></view>
  <view class="detail-empty" wx:elif="{{!loading}}">暫無復盤記錄</view>
</view>
