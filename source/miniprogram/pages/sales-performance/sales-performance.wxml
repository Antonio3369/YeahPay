<!--销售业绩页-->
<view class="page-container">

  <view class="access-locked" wx:if="{{accessDenied}}">
    <view class="access-locked-icon">⌛</view>
    <text class="access-locked-title">銷售業績暫未向銷售開放</text>
    <text class="access-locked-desc">當前賬號可以查看自己負責的商戶和個人數據，團隊業績排名功能後續開放。</text>
  </view>

  <block wx:if="{{!accessDenied}}">
    <!-- Tab：增量 / 存量 -->
    <view class="perf-tabs">
    <view class="perf-tab {{perfTab === 'new' ? 'active' : ''}}" bindtap="switchPerfTab" data-tab="new">本月增量</view>
    <view class="perf-tab {{perfTab === 'existing' ? 'active' : ''}}" bindtap="switchPerfTab" data-tab="existing">存量業績</view>
    </view>

  <!-- 统计卡 -->
  <view class="perf-stats" wx:if="{{stats}}">
    <view class="perf-stat-card c-ac"><view class="ps-num">{{stats.newMerchants}}</view><view class="ps-label">{{perfTab === 'new' ? '本月新增' : '本月存量'}}商戶</view></view>
    <view class="perf-stat-card c-wn"><view class="ps-num">{{stats.totalVolume}}</view><view class="ps-label">{{perfTab === 'new' ? '本月新增' : '本月存量'}}交易額</view></view>
    <view class="perf-stat-card c-sc"><view class="ps-num">{{stats.avgVolume}}</view><view class="ps-label">戶均</view></view>
    <view class="perf-stat-card"><view class="ps-num">{{stats.activeCount}}</view><view class="ps-label">有{{perfTab === 'new' ? '新增' : '存量'}}銷售</view></view>
  </view>

  <!-- TOP 3 排名 -->
    <view class="section-title" wx:if="{{perfTab === 'new'}}">
    <text>TOP 3 新增排名</text>
    <text>本月</text>
    </view>
    <view class="perf-rank-row" wx:if="{{perfTab === 'new' && rankList.length > 0}}">
    <view class="rank-card" wx:for="{{rankList}}" wx:key="sales_name" bindtap="goSalesDetail" data-name="{{item.sales_name}}">
      <text class="rank-badge {{index === 0 ? 'gold' : ''}}">{{index < 9 ? '0' + (index + 1) : index + 1}}</text>
      <view class="rank-num">{{item.new_merchants || 0}}</view>
      <text class="rank-sub">新增商戶</text>
      <text class="rank-vol">{{item.new_volume_fmt}} 首月交易</text>
      <text class="rank-name">{{item.sales_name}}</text>
    </view>
    </view>

  <!-- 走势图 -->
    <view class="section-title">
    <text>近 6 月{{perfTab === 'existing' ? '存量' : '新增'}}走勢</text>
    <text>/sales-performance/{{perfTab === 'existing' ? 'existing-trend' : 'trend'}}</text>
    </view>
    <view class="perf-chart">
    <ec-canvas wx:if="{{chartVisible}}" id="salesTrendChart" canvas-id="salesTrendChart" ec="{{ecTrend}}" />
    </view>
    <view class="empty-state" wx:if="{{trendData.length === 0}}">
    暫無近6月{{perfTab === 'existing' ? '存量' : '新增'}}數據
    </view>

  <!-- 销售画像 -->
    <view class="section-title">
    <text>銷售畫像 · 存量與增量對比</text>
    <text>TOP 6</text>
    </view>
    <view class="perf-grid" wx:if="{{salesGrid.length > 0}}">
    <view class="perf-card" wx:for="{{salesGrid}}" wx:key="sales_name" bindtap="goSalesDetail" data-name="{{item.sales_name}}">
      <view class="pc-hd">
        <view class="pc-avt">{{item.avatar}}</view>
        <text class="pc-name">{{item.sales_name}}</text>
      </view>
      <view class="pc-metrics">
        <view class="pc-metric"><text class="pc-label">存量商戶</text><text class="pc-val">{{item.existing}}</text></view>
        <view class="pc-metric"><text class="pc-label">本月新增</text><text class="pc-val pc-new">+{{item.new}}</text></view>
      </view>
      <view class="pc-mom-row"><text class="pc-mom-label">環比</text><text class="pc-mom {{item.mom >= 0 ? 'mom-up' : 'mom-down'}}">{{item.mom_fmt}}</text></view>
    </view>
    </view>

  <!-- 历史业绩表格 -->
    <view class="section-title">
    <text>歷史業績</text>
    <text>近 6 月</text>
    </view>
    <view class="history-tabs">
    <view class="h-tab {{perfMetric === 'merchants' ? 'active' : ''}}" bindtap="switchMetric" data-metric="merchants">商戶數</view>
    <view class="h-tab {{perfMetric === 'total_volume' ? 'active' : ''}}" bindtap="switchMetric" data-metric="total_volume">交易額</view>
    <view class="h-tab {{perfMetric === 'avg_volume' ? 'active' : ''}}" bindtap="switchMetric" data-metric="avg_volume">戶均</view>
    <view class="h-tab {{perfMetric === 'txn_count' ? 'active' : ''}}" bindtap="switchMetric" data-metric="txn_count">筆數</view>
    </view>
    <scroll-view scroll-x class="history-scroll" wx:if="{{historyTable.length > 0}}">
    <view class="history-table">
      <view class="h-row h-header">
        <text class="h-cell h-cell-name">銷售</text>
        <text class="h-cell" wx:for="{{historyPeriods}}" wx:key="*this">{{item}}月</text>
      </view>
      <view class="h-row" wx:for="{{historyTable}}" wx:key="sales_name">
        <text class="h-cell h-cell-name">{{item.sales_name}}</text>
        <text class="h-cell h-cell-val" wx:for="{{item.cells}}" wx:key="*this" style="color:{{item.color || '#94A3B8'}};background:{{item.bg || 'transparent'}}">{{item.display}}</text>
      </view>
    </view>
    </scroll-view>
  </block>

</view>
