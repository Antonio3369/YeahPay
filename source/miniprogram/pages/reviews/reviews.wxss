.reviews-page{padding-bottom:70rpx}.reviews-hero{position:relative;padding:28rpx 0 30rpx;border-bottom:2rpx solid var(--line)}.reviews-kicker{font-size:18rpx;letter-spacing:4rpx;color:var(--ac);font-weight:700}.reviews-title{margin-top:10rpx;font-size:42rpx;line-height:1.15;color:var(--text);font-weight:700}.reviews-subtitle{margin-top:10rpx;font-size:22rpx;color:var(--t3)}.export-btn{position:absolute;right:0;bottom:32rpx;height:62rpx;line-height:62rpx;padding:0 22rpx;border:0;border-radius:var(--rs);background:var(--ac);color:var(--bg);font-size:21rpx;font-weight:700}.export-btn::after{border:0}.review-stats{display:flex;gap:12rpx;margin:24rpx 0}.review-stat{flex:1;min-width:0;padding:20rpx 8rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--rs);text-align:center}.review-stat-success{border-color:rgba(72,181,142,.24)}.review-stat-warn{border-color:rgba(197,146,69,.24)}.review-stat-value{display:block;font-size:32rpx;line-height:1.1;color:var(--ac);font-weight:700;font-variant-numeric:tabular-nums}.review-stat-success .review-stat-value{color:var(--sc)}.review-stat-warn .review-stat-value{color:var(--wn)}.review-stat-label{display:block;margin-top:8rpx;font-size:18rpx;color:var(--t3)}.review-search-row{display:flex;align-items:center;gap:14rpx;margin-bottom:16rpx}.review-search{flex:1;height:70rpx;box-sizing:border-box;padding:0 20rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--rs);color:var(--text);font-size:23rpx}.search-clear,.date-clear{color:var(--ac);font-size:20rpx;white-space:nowrap}.filter-scroll{width:100%;white-space:nowrap;margin-bottom:14rpx}.filter-row{display:inline-flex;gap:10rpx}.filter-chip{padding:12rpx 20rpx;border:2rpx solid var(--line);border-radius:999rpx;color:var(--t3);font-size:20rpx;background:var(--card)}.filter-chip.selected{border-color:rgba(102,119,223,.5);background:rgba(102,119,223,.12);color:var(--ac)}.date-row{display:flex;align-items:center;gap:10rpx;margin-bottom:28rpx}.date-picker{min-width:198rpx;height:58rpx;box-sizing:border-box;padding:0 16rpx;line-height:58rpx;border:2rpx solid var(--line);border-radius:var(--rs);color:var(--t2);font-size:19rpx;background:var(--card)}.date-dash{color:var(--t3)}.review-section-head{display:flex;justify-content:space-between;align-items:center;margin:0 2rpx 14rpx;color:var(--text);font-size:27rpx;font-weight:600}.review-count{color:var(--t3);font-size:19rpx;font-weight:400}.review-list{display:flex;flex-direction:column;gap:16rpx}.review-card{position:relative;padding:24rpx 22rpx 22rpx;background:var(--card);border-radius:var(--r);border:2rpx solid var(--line)}.review-card-top{display:flex;align-items:center;gap:14rpx}.review-merchant{min-width:0;flex:1;color:var(--ac);font-size:27rpx;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.review-status{padding:5rpx 12rpx;border-radius:8rpx;font-size:18rpx;white-space:nowrap}.review-status-resolved{color:var(--sc);background:rgba(72,181,142,.12)}.review-status-following{color:var(--wn);background:rgba(197,146,69,.12)}.review-source{margin-top:12rpx;color:var(--t2);font-size:21rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.review-card-meta{display:flex;gap:18rpx;margin-top:16rpx;padding-top:14rpx;border-top:2rpx solid var(--line);color:var(--t3);font-size:19rpx}.review-card-meta text:last-child{margin-left:auto}.review-note{margin-top:14rpx;color:var(--t2);font-size:21rpx;line-height:1.55;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.review-card-arrow{margin-top:16rpx;color:var(--ac);font-size:20rpx;text-align:right}.review-empty{display:flex;flex-direction:column;align-items:center;padding:100rpx 0;color:var(--t3);font-size:23rpx}.review-empty-mark{font-size:46rpx;color:var(--ac);margin-bottom:16rpx}.review-empty-sub{margin-top:10rpx;font-size:20rpx}
.export-btn{color:#FFFFFF}
