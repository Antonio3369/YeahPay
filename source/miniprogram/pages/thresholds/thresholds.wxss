.thresholds-page{padding-bottom:70rpx}
.threshold-intro{padding:36rpx 0 28rpx}.intro-kicker{font-size:20rpx;letter-spacing:4rpx;color:var(--ac);font-weight:700}.intro-title{font-size:42rpx;color:var(--text);font-weight:700;margin-top:10rpx}.intro-desc{font-size:23rpx;color:var(--t3);margin-top:12rpx;line-height:1.6}
.threshold-list{display:flex;flex-direction:column;gap:16rpx}.threshold-card{background:var(--card);border:2rpx solid var(--line);border-radius:var(--r);padding:24rpx 20rpx}.threshold-copy{margin-bottom:18rpx}.threshold-name{font-size:28rpx;color:var(--text);font-weight:700}.threshold-desc{font-size:21rpx;color:var(--t3);margin-top:8rpx;line-height:1.5}.threshold-edit{display:flex;align-items:center;justify-content:flex-end}.threshold-input{width:180rpx;height:68rpx;box-sizing:border-box;background:var(--card2);border:2rpx solid var(--line);border-radius:var(--rs);color:var(--text);font-size:27rpx;text-align:right;padding:0 16rpx}.threshold-unit{color:var(--t3);font-size:22rpx;width:70rpx;text-align:center}.threshold-save{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:112rpx;min-width:112rpx;height:68rpx;line-height:1;margin:0;padding:0;border:0;border-radius:var(--rs);background:var(--ac);color:#07111f;font-size:22rpx;font-weight:700;vertical-align:middle}.threshold-save::after{border:0}.regenerate-btn{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;margin:28rpx 0 0;height:84rpx;line-height:1;background:var(--wn);color:#171005;border:0;border-radius:var(--rs);font-size:25rpx;font-weight:700}.regenerate-btn::after{border:0}.empty-state{text-align:center;color:var(--t3);padding:100rpx 0}
