.detail-header{padding:12rpx 0;display:flex;flex-direction:column;gap:10rpx}
.detail-name{font-size:28rpx;color:var(--t2)}
.detail-meta{font-size:20rpx;color:var(--t3)}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:24rpx 0}
.summary-card{background:var(--card);border:2rpx solid var(--line);border-radius:var(--rs);padding:22rpx 18rpx;display:flex;flex-direction:column;gap:8rpx}
.summary-value{font-size:28rpx;color:var(--ac);font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.summary-label{font-size:20rpx;color:var(--t3)}
.detail-meta-card{margin-bottom:24rpx}
.detail-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:2rpx solid var(--line)}
.detail-row:last-child{border-bottom:none}
.dr-label{font-size:26rpx;color:var(--text)}
.dr-value{font-size:26rpx;color:var(--ac);font-weight:500;font-variant-numeric:tabular-nums}
.dr-muted{color:var(--t2);font-size:22rpx}
.detail-chart{width:100%;height:360rpx;margin:-4rpx 0 12rpx}
.detail-chart-tall{height:420rpx}
.detail-chart ec-canvas{display:block;width:100%;height:100%}
.detail-link{color:var(--ac);text-decoration:underline;text-decoration-color:rgba(102,119,223,.35)}
.push-card{margin-bottom:24rpx}
.push-title{font-size:26rpx;color:var(--text);font-weight:600}
.push-desc{margin:10rpx 0 16rpx;color:var(--t3);font-size:20rpx;line-height:1.5}
.push-picker,.push-note{box-sizing:border-box;width:100%;height:72rpx;padding:0 20rpx;border:2rpx solid var(--line);border-radius:var(--rs);background:rgba(255,255,255,.02);color:var(--text);font-size:22rpx;line-height:72rpx}
.push-placeholder{color:var(--t3)}
.push-note{margin-top:14rpx;line-height:normal;padding-top:0}
.push-submit{margin:18rpx 0 0;background:var(--ac);color:#06101d;border-radius:var(--rs);font-size:23rpx;font-weight:600}
.push-empty{padding:18rpx 0;color:var(--t3);font-size:21rpx}
.push-account-btn{margin:6rpx 0 0;background:rgba(102,119,223,.12);color:var(--ac);border:2rpx solid rgba(102,119,223,.3);border-radius:var(--rs);font-size:22rpx}
