<!--万事达卡排行-->
<view class="page-container">
  <view class="rank-search">
    <input class="rank-search-input" placeholder="搜尋商戶名稱或ID（全量）" placeholder-class="input-placeholder" value="{{searchText}}" bindinput="onSearch" confirm-type="search" />
    <text class="rank-search-total">共 {{total}} 家</text>
  </view>
  <view class="simple-table">
    <view class="st-row st-header">
      <text class="st-cell" style="width:60rpx">#</text>
      <text class="st-cell st-cell-wide">商戶</text>
      <text class="st-cell">交易額</text>
      <text class="st-cell">等級</text>
    </view>
    <view class="st-row" wx:for="{{list}}" wx:key="merchant_id" bindtap="goMerchantDetail" data-id="{{item.merchant_id}}">
      <text class="st-cell" style="width:60rpx;color:var(--ac);font-weight:700">{{index < 9 ? '0' + (index + 1) : index + 1}}</text>
      <text class="st-cell st-cell-wide entity-link">{{item.merchant_name}}</text>
      <text class="st-cell">{{item.amount_fmt}}</text>
      <text class="st-cell" style="color:{{item.level === 'critical' ? '#EF4444' : item.level === 'warning' ? '#F59E0B' : '#94A3B8'}};font-weight:{{item.level === 'critical' ? '700' : '500'}}">
        {{item.level === 'critical' ? '⚠ 高' : item.level === 'warning' ? '中' : '低'}}
      </text>
    </view>
  </view>
  <view class="list-footer" wx:if="{{loadingMore}}">正在載入更多...</view>
  <view class="list-footer list-footer-muted" wx:if="{{list.length > 0 && !hasMore}}">已加載全部商戶</view>
</view>
