<view class="page-container update-page">
  <view class="update-hero">
    <view class="hero-mark">↻</view>
    <view class="hero-copy">
      <text class="hero-title">上傳數據文件</text>
      <text class="hero-subtitle">請用 Excel「另存為 CSV UTF-8」，不要只改副檔名</text>
    </view>
  </view>

  <view wx:if="{{!accessGranted}}" class="card lock-card">
    <view class="section-title">
      <text>管理員驗證</text>
      <text>SECURE</text>
    </view>
    <text class="lock-hint">任何人都可以進入本頁，但需要再次輸入當前管理員密碼才能上傳並發布本地數據。</text>
    <input
      class="password-input"
      password
      value="{{password}}"
      placeholder="請輸入管理密碼"
      placeholder-class="password-placeholder"
      bindinput="onPasswordInput"
      bindconfirm="verifyPassword"
    />
    <button class="btn btn-primary verify-btn" loading="{{verifying}}" disabled="{{verifying || !password}}" bindtap="verifyPassword">驗證並繼續</button>
    <text class="integration-note">密碼只用於本機核對角色，不會發到服務器。</text>
  </view>

  <block wx:if="{{accessGranted}}">
    <view class="card source-card">
      <view class="section-title">
        <text>選擇文件</text>
        <text>{{status.checkedAt || '待上傳'}}</text>
      </view>

      <view class="source-row" bindtap="pickTransactions">
        <view class="source-icon detail-icon">D</view>
        <view class="source-copy">
          <text class="source-title">交易明細 CSV / JSON</text>
          <text class="source-meta">{{detailFile || 'Excel 需另存為 CSV UTF-8 後再選'}}</text>
        </view>
        <text class="source-date">{{status.detailDate || '待上傳'}}</text>
      </view>

      <view class="source-row" bindtap="pickMerchants">
        <view class="source-icon summary-icon">M</view>
        <view class="source-copy">
          <text class="source-title">商戶主數據（可選）</text>
          <text class="source-meta">{{merchantFile || '無則按交易推斷商戶'}}</text>
        </view>
        <text class="source-date">{{status.summaryDate || '可選'}}</text>
      </view>

      <view class="consistency-row">
        <text class="consistency-label">本機數據包</text>
        <text class="consistency-badge {{status.consistent ? 'is-ok' : 'is-pending'}}">{{status.consistencyText || '待上傳'}}</text>
      </view>
    </view>

    <view wx:if="{{status.candidateExists}}" class="card impact-card">
      <view class="section-title">
        <text>讀取結果</text>
        <text class="validation-state {{status.validationOk ? 'is-valid' : 'is-blocked'}}">
          {{status.validationOk ? '可確認寫入' : '待上傳交易'}}
        </text>
      </view>
      <view class="impact-grid">
        <view class="impact-item"><text>商戶</text><text>{{status.entityChanges.merchant_added || 0}}</text></view>
        <view class="impact-item"><text>交易筆數</text><text>{{preview.txnCount || 0}}</text></view>
        <view class="impact-item"><text>最早日期</text><text>{{preview.minDate || '-'}}</text></view>
        <view class="impact-item"><text>最晚日期</text><text>{{preview.maxDate || '-'}}</text></view>
      </view>
      <text wx:for="{{status.validationIssues}}" wx:key="*this" class="audit-message is-error">{{item}}</text>
      <text wx:for="{{status.validationWarnings}}" wx:key="*this" class="audit-message is-warning">{{item}}</text>
    </view>

    <view class="card publish-card">
      <view class="section-title">
        <text>業務截止日期</text>
        <text>LOCAL</text>
      </view>
      <text class="publish-date">{{status.publishDate || '待確認'}}</text>
      <text class="publish-hint">Excel 不能改後綴當 CSV。用「檔案 → 另存為 → CSV UTF-8（逗號分隔）」。表頭需有商戶號/編號、交易時間、金額。確認後只寫入本機。</text>
      <button class="btn btn-primary publish-btn" loading="{{importing}}" disabled="{{!status.canPublish || importing}}" bindtap="confirmPublish">確認寫入本機數據</button>
    </view>
  </block>
</view>
