.update-page{padding-top:32rpx}
.update-hero{display:flex;align-items:center;padding:12rpx 8rpx 32rpx}
.hero-mark{width:78rpx;height:78rpx;border-radius:24rpx;background:rgba(102,119,223,.14);border:2rpx solid rgba(102,119,223,.28);display:flex;align-items:center;justify-content:center;color:var(--ac);font-size:48rpx;margin-right:22rpx}
.hero-copy{display:flex;flex-direction:column}
.hero-title{font-size:38rpx;font-weight:700;color:var(--text)}
.hero-subtitle{font-size:22rpx;color:var(--t2);margin-top:8rpx}
.lock-card,.source-card,.publish-card{padding:30rpx}
.lock-hint{display:block;color:var(--t2);font-size:25rpx;line-height:1.7;margin:8rpx 0 24rpx}
.password-input{height:92rpx;padding:0 24rpx;background:var(--card2);border:2rpx solid var(--line);border-radius:var(--rs);box-sizing:border-box;color:var(--text);font-size:28rpx;margin-bottom:20rpx}
.password-input:focus{border-color:var(--ac)}
.password-placeholder{color:var(--t3)}
.verify-btn,.publish-btn{width:100%;margin:0}
.integration-note{display:block;text-align:center;color:var(--t3);font-size:20rpx;margin-top:20rpx}
.source-row{display:flex;align-items:center;padding:24rpx 0;border-bottom:2rpx solid var(--line)}
.source-row:last-of-type{border-bottom:none}
.source-icon{width:64rpx;height:64rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:700;margin-right:20rpx}
.detail-icon{color:var(--ac);background:rgba(102,119,223,.14)}
.summary-icon{color:#A78BFA;background:rgba(167,139,250,.14)}
.source-copy{flex:1;display:flex;flex-direction:column}
.source-title{font-size:27rpx;color:var(--text);font-weight:500}
.source-meta{font-size:21rpx;color:var(--t3);margin-top:6rpx}
.source-date{font-size:25rpx;color:var(--ac);font-variant-numeric:tabular-nums}
.consistency-row{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding-top:24rpx;border-top:2rpx solid var(--line)}
.consistency-label{font-size:24rpx;color:var(--t2)}
.consistency-badge{padding:8rpx 16rpx;border-radius:10rpx;font-size:21rpx}
.is-ok{color:var(--sc);background:rgba(72,181,142,.14)}
.is-pending{color:var(--wn);background:rgba(197,146,69,.14)}
.publish-date{display:block;font-size:56rpx;font-weight:700;letter-spacing:2rpx;color:var(--ac);text-align:center;padding:24rpx 0 16rpx;font-variant-numeric:tabular-nums}
.publish-hint{display:block;text-align:center;color:var(--t2);font-size:23rpx;line-height:1.65;margin-bottom:28rpx}
.publish-btn[disabled]{opacity:.4}
.refresh-btn{width:100%;margin:18rpx 0 0}
.impact-card{padding:30rpx}
.validation-state{font-size:20rpx!important;letter-spacing:0!important}
.is-valid{color:var(--sc)!important}.is-blocked{color:#E56D78!important}
.impact-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}
.impact-item{display:flex;justify-content:space-between;padding:18rpx;background:var(--card2);border-radius:14rpx;color:var(--t2);font-size:22rpx}
.impact-item text:last-child{color:var(--text);font-weight:600;font-variant-numeric:tabular-nums}
.audit-message{display:block;font-size:21rpx;line-height:1.55;margin-top:14rpx}
.audit-message.is-error{color:#E56D78}.audit-message.is-warning{color:var(--wn)}
